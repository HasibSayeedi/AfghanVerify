# Copy this file to .env and replace every placeholder before starting Compose.
# The .env file is ignored by Git and excluded from Docker build contexts.

# SQL Server requires a strong password containing upper/lowercase letters,
# a number, and a symbol. Do not use this placeholder as a real password.
DB_PASSWORD=Replace-With-A-Strong-SQL-Password!2026

# Use at least 32 random characters for JWT signing.
JWT_KEY=replace-with-at-least-32-cryptographically-random-characters

# Use an independent high-entropy key for HMAC credential signatures.
CRYPTOGRAPHY_SIGNING_KEY=replace-with-an-independent-high-entropy-signing-key

JWT_EXPIRATION_MINUTES=30
FRONTEND_ORIGIN=http://localhost:8080
FRONTEND_PORT=8080
API_PORT=5081

# SMTP account used to deliver single-use password recovery links.
# Obtain these values from the Ministry's institutional email provider.
SMTP_HOST=smtp.example.gov.af
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.gov.af
SMTP_PASSWORD=replace-with-the-smtp-account-password
SMTP_FROM_ADDRESS=no-reply@example.gov.af
SMTP_FROM_NAME=Afghan Verify
SMTP_ENABLE_SSL=true

# Public browser origin used inside emailed reset links (no trailing slash).
PUBLIC_FRONTEND_URL=https://verify.mohe.gov.af
PASSWORD_RESET_TOKEN_MINUTES=30
